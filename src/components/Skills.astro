---
import { useTranslations, defaultLang } from '../i18n/ui';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section class="pane pane-skills" aria-labelledby="skills-title">
  <div class="pane-heading">
    <span class="pane-number">04</span>
    <span id="skills-title">{t('nav.skills')}</span>
    <span class="pane-mark">▾</span>
  </div>
  <div class="skill-categories">
    <div class="skill-category">
      <span class="category-label">{t('skills.languages')}</span>
      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span> Go
        </div>
        <ul class="skill-list">
          <li class="skill-item">net/http</li>
          <li class="skill-item">pgx</li>
          <li class="skill-item">testing</li>
          <li class="skill-item">log/slog</li>
        </ul>
      </div>

      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span> TypeScript
        </div>
        <ul class="skill-list">
          <li class="skill-item">NestJS</li>
          <li class="skill-item">Express</li>
          <li class="skill-item">React</li>
        </ul>
      </div>
    </div>

    <div class="skill-category">
      <span class="category-label">{t('skills.databases')}</span>
      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span> SQL
        </div>
        <ul class="skill-list">
          <li class="skill-item">PostgreSQL</li>
          <li class="skill-item">MySQL</li>
          <li class="skill-item">SQL Server</li>
        </ul>
      </div>

      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span> NoSQL
        </div>
        <ul class="skill-list">
          <li class="skill-item">MongoDB</li>
          <li class="skill-item">Redis</li>
        </ul>
      </div>
    </div>

    <div class="skill-category">
      <span class="category-label">{t('skills.architecture')}</span>
      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span> APIs
        </div>
        <ul class="skill-list">
          <li class="skill-item">REST APIs</li>
          <li class="skill-item">API Gateway</li>
          <li class="skill-item">JWT</li>
        </ul>
      </div>

      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span>
          {t('skills.tagArchitecture')}
        </div>
        <ul class="skill-list">
          <li class="skill-item">{t('skills.microservices')}</li>
          <li class="skill-item">Hexagonal Arch.</li>
          <li class="skill-item">TDD</li>
        </ul>
      </div>
    </div>

    <div class="skill-category">
      <span class="category-label">{t('skills.cloud')}</span>
      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span> Cloud
        </div>
        <ul class="skill-list">
          <li class="skill-item">Docker</li>
          <li class="skill-item">AWS (IAM, EC2)</li>
          <li class="skill-item">CI/CD</li>
        </ul>
      </div>

      <div class="skill-block">
        <div class="skill-group-title">
          <span class="tree-marker">&gt;</span>
          {t('skills.tools')}
        </div>
        <ul class="skill-list">
          <li class="skill-item">Git</li>
          <li class="skill-item">GitHub Actions</li>
        </ul>
      </div>
    </div>
  </div>
</section>
