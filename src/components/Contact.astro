---
import { useTranslations, defaultLang } from '../i18n/ui';
import LinkedInIcon from '../../public/linkedin.svg';
import GitHubIcon from '../../public/github.svg';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section class="pane pane-contact" aria-labelledby="contact-title">
  <div class="pane-heading">
    <span class="pane-number">05</span>
    <span id="contact-title">{t('nav.contact')}</span>
    <span class="pane-mark">▾</span>
  </div>

  <div class="contact-grid">
    <div class="contact-primary">
      <p class="contact-copy">
        {t('contact.copy')}
      </p>
      <a class="contact-link" href="mailto:contact@eliottvelarde.com">
        contact@eliottvelarde.com <span>↗</span>
      </a>
    </div>

    <div class="contact-socials">
      <span class="category-label">{t('contact.network')}</span>
      <a
        href="https://www.linkedin.com/in/eliott-velarde/"
        target="_blank"
        rel="noopener noreferrer"
      >
        <LinkedInIcon />
        LinkedIn ↗
      </a>
      <a
        href="https://github.com/EliottV17"
        target="_blank"
        rel="noopener noreferrer"
      >
        <GitHubIcon />
        GitHub ↗
      </a>
    </div>

    <div class="contact-terminal">
      <span class="category-label">{t('contact.sysInfo')}</span>
      <p class="sys-info">
        <span>{t('contact.locationLabel')}</span>
        {t('contact.locationValue')}
      </p>
      <p class="sys-info">
        <span>{t('contact.statusLabel')}</span>
        {t('contact.statusValue')}
      </p>
      <div class="cli-box">
        <a
          href="/Eliott_Velarde_CV_EN.pdf"
          download="Eliott_Velarde_CV_EN.pdf"
          rel="noopener noreferrer"
          class="terminal-line"
          title={t('contact.cvEnTitle')}
        >
          <span class="prompt">$</span> curl -O eliottvelarde/cv-en.pdf [ Download
          ↗ ]
        </a>
        <a
          href="/Eliott_Velarde_CV_ES.pdf"
          download="Eliott_Velarde_CV_ES.pdf"
          hreflang="es"
          rel="noopener noreferrer"
          class="terminal-line"
          title={t('contact.cvEsTitle')}
        >
          <span class="prompt">$</span> curl -O eliottvelarde/cv-es.pdf [ Download
          ↗ ] <span class="cursor"></span>
        </a>
      </div>
    </div>
  </div>
</section>
