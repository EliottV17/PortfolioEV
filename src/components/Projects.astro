---
import { useTranslations, defaultLang } from '../i18n/ui';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const projects = [
  {
    id: 'sentinel',
    name: 'Sentinel',
    url: 'https://github.com/EliottV17/sentinel-project',
    videoUrl: 'https://youtu.be/0To4e1rmMRM',
    detail: t('projects.sentinel.detail'),
    stack:
      'TypeScript · Go ·  NestJS · Postgres · PrismaORM · JWT · CI/CD · Jest',
    color: 'red',
  },
  {
    id: 'gymBuddy',
    name: 'Gym Buddy',
    url: 'https://github.com/EliottV17/Gym-Buddy-App',
    detail: t('projects.gymBuddy.detail'),
    stack: 'TypeScript · NestJS · Postgres · TypeORM · PostGIS · JWT',
    color: 'blue',
  },
];
---

<section class="pane pane-projects" aria-labelledby="projects-title">
  <div class="pane-heading">
    <span class="pane-number">03</span>
    <span id="projects-title">{t('nav.projects')}</span>
    <span class="pane-mark">▾</span>
  </div>
  <div class="project-list">
    {
      projects.map((project, index) => (
        <div class={`project-row ${project.color}`}>
          <div class={`project-copy ${project.color}`}>
            <div class="project-title-row">
              <strong>{project.name}</strong>
              {project.videoUrl && (
                <a
                  class="project-tag-link"
                  href={project.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name} demo video`}
                >
                  [▶ Video]
                </a>
              )}
              <a
                class="project-tag-link"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                [ GitHub ↗ ]
              </a>
            </div>
            <span class="project-detail">{project.detail}</span>
            <small>{project.stack}</small>
          </div>
          <span class={`project-index ${project.color}`}>0{index + 1}</span>
        </div>
      ))
    }
  </div>
</section>
