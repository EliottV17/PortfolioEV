`,
    highlights: [
      t('projects.gymBuddy.highlight1'),
      t('projects.gymBuddy.highlight2'),
    ],
  },
  {
    id: 'tenantInbox',
    name: 'TenantInbox',
    url: 'https://github.com/EliottV17/TenantInbox',
    webUrl: 'https://tenant-inbox-ten.vercel.app/inbox',
    filename: 'tenantinbox.ts',
    detail: t('projects.tenantInbox.detail'),
    stack:
      'Next.js (App Router) · TypeScript · Convex · OpenRouter (GLM-5.3-flash) · Zod 4 · Tailwind CSS v4 · shadcn/ui · Bun · Vitest',
    color: 'green',
    techIcon: 'ts',
    diagram: `
┌─────────────────┐   ┌─────────────────┐
│   Inbox form    │   │  POST webhook   │
└────────┬────────┘   └────────┬────────┘
         │                     │
         ▼                     ▼
┌─────────────────┐   ┌─────────────────┐
│ Create mutation │   │ Webhook handler │
└────────┬────────┘   └────────┬────────┘
         └──────────┬──────────┘
                    ▼
        ┌───────────────────────┐
        │   Save message: new   │
        └───────────┬───────────┘
                    │
                    ▼
       ┌─────────────────────────┐
       │ Schedule classification │
       └────────────┬────────────┘
                    │
                    ▼
        ┌───────────────────────┐
        │ Classification action │
        └───────────┬───────────┘
                    │
                    ▼
         ┌─────────────────────┐
         │ State + usage guard │
         └──────────┬──────────┘
                    │
                    ▼
