---
import { useTranslations, defaultLang } from '../i18n/ui';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const projects = [
  {
    id: 'sentinel',
    name: 'Sentinel',
    url: 'https://github.com/EliottV17/sentinel-project',
    detail: t('projects.sentinel.detail'),
    stack:
      'Python · Go ·  FastAPI · Postgres · SQLModel · JWT · CI/CD · Pytest',
    color: 'red',
  },
  {
    id: 'gymBuddy',
    name: 'Gym Buddy',
    url: 'https://github.com/EliottV17/gym-buddy-api',
    detail: t('projects.gymBuddy.detail'),
    stack: 'TypeScript · NestJS · Postgres · TypeORM · PostGIS · JWT',
    color: 'blue',
  },
];
---

<section class="pane pane-projects" aria-labelledby="projects-title">
  <div class="pane-heading">
    <span class="pane-number">03</span>
    <span id="projects-title">{t('nav.projects')}</span>
    <span class="pane-mark">▾</span>
  </div>
  <div class="project-list">
    {
      projects.map((project, index) => (
        <div class="project-row">
          <a
            class={`project-icon ${project.color}`}
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            title={`${t('projects.viewRepo')} ${project.name}`}
          >
            ↗
          </a>
          <div class="project-copy">
            <strong>{project.name}</strong>
            <span class="project-detail">{project.detail}</span>
            <small>{project.stack}</small>
          </div>
          <span class="project-index">0{index + 1}</span>
        </div>
      ))
    }
  </div>
</section>
