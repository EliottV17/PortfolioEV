---
import '../styles/global.css';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params;
const currentLang = lang === 'es' ? 'es' : 'en';
---

<html lang={currentLang} class="dark" style="color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#090808" />
    <meta name="color-scheme" content="dark" />
    <title>
      {
        currentLang === 'es'
          ? 'Eliott Velarde — Ingeniero de Software Backend'
          : 'Eliott Velarde — Backend Software Engineer'
      }
    </title>
    <meta
      name="description"
      content={currentLang === 'es'
        ? 'Portafolio de Eliott Velarde. Ingeniero de software Backend enfocado en APIs, sistemas backend, diseño de sistemas y arquitectura de software'
        : "Eliott Velarde's Portfolio. Backend Software Engineer focused on APIs, backend systems, system design, and software architecture."}
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="antialiased">
    <main class="terminal-shell">
      <div class="terminal-window">
        <div class="workspace">
          <About lang={currentLang} />
          <Experience lang={currentLang} />
          <Projects lang={currentLang} />
          <Skills lang={currentLang} />
          <Contact lang={currentLang} />
        </div>
        <footer class="status-bar">
          <span class="status-normal">NORMAL</span>
          <span class="status-branch">
            <span class="branch-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="608 0 832 2048"
                width="0.41em"
                height="1em"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  transform="matrix(1 0 0 -1 0 1638)"
                  d="M852 -410h-244v427q0 161 68 259q51 72 150 135l136 88q76 51 112 123q34 67 34 185v291h-184l258 302l258 -302h-184v-341q0 -168 -48 -261q-47 -90 -142 -152l-66 -45q-85 -56 -112 -109q-36 -63 -36 -173v-427zM852 638l-244 -158v1158h244v-1000z"
                ></path>
              </svg>
            </span>
            <span class="branch-name">main</span>
          </span>

          <span class="status-right">
            <span class="status-encoding">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 640 2048 768"
                width="1em"
                height="0.375em"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  transform="matrix(1 0 0 -1 0 1638)"
                  d="M153 768v4l22 26l9 4h356l5 -4l-18 -26l-8 -4h-366zM6 676l-5 5l22 26l13 4h452l4 -9l-8 -21l-9 -5h-469zM245 585v4l13 26l8 5h200l5 -5v-26l-9 -4h-217zM1279 785l-165 -44q-12 -4 -17 -2q-3 1 -13 11q-20 24 -48 39q-88 43 -178 -17q-105 -69 -100 -187q0 -63 37 -107q37 -46 93 -54q99 -9 174 70l26 34h-191q-32 0 -22 31l52 109q8 17 26 17h318q20 60 69 130q106 136 278 166q164 30 287 -53q121 -83 139 -221q25 -198 -117 -340q-97 -97 -239 -126l-78 -8q-144 4 -244 87q-74 65 -95 152l-44 -65q-108 -148 -282 -166q-153 -26 -268 61q-115 86 -128 222q-19 161 87 298q105 137 278 167q149 25 261 -47q77 -53 117 -140q4 -13 -13 -17zM1849 637l-5 31q-14 73 -71 110q-59 37 -133 24q-144 -35 -174 -174q-14 -56 12.5 -111.5t78.5 -75.5q82 -35 166 5q117 61 126 191z"
                ></path>
              </svg>
              <span class="status-separator">|</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 2048 2048"
                width="1em"
                height="1em"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  transform="matrix(1 0 0 -1 0 1638)"
                  d="M0 614v1024h2048v-2048h-2048v1024zM1650 696q-47 8 -90 8q-40 0 -66 -4q-84 -17 -139 -68t-71 -127q-2 -12 -2 -53q0 -48 6 -77q19 -61 56 -103q32 -34 73 -59.5t121 -59.5q68 -30 98 -47.5t42 -34.5q16 -21 16 -49q0 -37 -28 -64q-33 -30 -92 -32.5t-108 23.5q-43 27 -76 74l-12 18l-60 -35l-74 -43q-3 -2 -10 -6t-10 -6q-3 -3 18 -33.5t36 -45.5q86 -87 206 -106q50 -7 86 -7q40 0 70 4q86 14 144.5 56t83.5 107q21 58 15 129t-39 120q-28 44 -83 80.5t-165 83.5q-60 27 -84 42.5t-34 36.5q-10 18 -10 36v3q0 41 27.5 63t74.5 19q31 -1 56.5 -17t39.5 -41q8 -11 12 -16t6 -4q26 16 60.5 38.5t58 39.5t23.5 18q-22 38 -48 65q-51 55 -128 74zM1168 610v85h-358q-358 0 -358 -1q-1 -8 -1.5 -20.5t-1.5 -23t-1 -20.5v-22v-82h266v-757h190v757h264v84z"
                ></path>
              </svg>
            </span>

            <span class="status-lang">
              <span
                class="lang-switch"
                role="navigation"
                aria-label="Language selector"
              >
                <a
                  href="/"
                  class:list={['lang-link', { active: currentLang === 'en' }]}
                  aria-current={currentLang === 'en' ? 'page' : undefined}>en</a
                ><span class="lang-sep">/</span><a
                  href="/es/"
                  class:list={['lang-link', { active: currentLang === 'es' }]}
                  aria-current={currentLang === 'es' ? 'page' : undefined}>es</a
                >
              </span>
            </span>

            <span class="status-location">
              <span id="nvim-percent">0% </span>
              <span id="nvim-cursor">0:0</span>
            </span>
          </span>
        </footer>
      </div>
    </main>
  </body>
</html>

<script src="../scripts/status-bar.ts"></script>
