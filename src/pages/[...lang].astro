---
import '../styles/global.css';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'es' } }];
}

const { lang } = Astro.params;
const currentLang = lang === 'es' ? 'es' : 'en';
---

<html lang={currentLang} class="dark" style="color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" content="#090808" />
    <meta name="color-scheme" content="dark" />
    <title>
      {
        currentLang === 'es'
          ? 'Eliott Velarde — Ingeniero de Software Backend'
          : 'Eliott Velarde — Backend Software Engineer'
      }
    </title>
    <meta
      name="description"
      content={currentLang === 'es'
        ? 'Portafolio de Eliott Velarde. Ingeniero de software Backend enfocado en APIs, sistemas backend, diseño de sistemas y arquitectura de software'
        : "Eliott Velarde's Portfolio. Backend Software Engineer focused on APIs, backend systems, system design, and software architecture."}
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="antialiased">
    <main class="terminal-shell">
      <div class="terminal-window">
        <div class="workspace">
          <About lang={currentLang} />
          <Experience lang={currentLang} />
          <Projects lang={currentLang} />
          <Skills lang={currentLang} />
          <Contact lang={currentLang} />
        </div>
        <footer class="status-bar">
          <span class="status-normal">NORMAL</span>
          <span class="status-branch">
            <span class="branch-icon"></span>
            <span class="branch-name">main</span>
          </span>

          <span class="status-right">
            <span class="status-lang">
              <span
                class="lang-switch"
                role="navigation"
                aria-label="Language selector"
              >
                <a
                  href="/"
                  class:list={['lang-link', { active: currentLang === 'en' }]}
                  aria-current={currentLang === 'en' ? 'page' : undefined}>en</a
                ><span class="lang-sep">/</span><a
                  href="/es/"
                  class:list={['lang-link', { active: currentLang === 'es' }]}
                  aria-current={currentLang === 'es' ? 'page' : undefined}>es</a
                >
              </span>
            </span>

            <span class="status-location">
              <span id="nvim-percent">0% </span>
              <span id="nvim-cursor">0:0</span>
            </span>
          </span>
        </footer>
      </div>
    </main>
  </body>
</html>

<script src="../scripts/status-bar.ts"></script>
