---
import { getSkills } from '../lib/skills';
import { useTranslations, defaultLang } from '../i18n/ui';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const skills = getSkills(lang);
---

<section class="pane pane-skills" aria-labelledby="skills-title">
  <div class="pane-heading">
    <span class="pane-number">04</span>
    <span id="skills-title">{t('nav.skills')}</span>
    <span class="pane-mark">▾</span>
  </div>
  <p
    class="skills-prompt"
    aria-label={lang === 'es'
      ? 'Listado del directorio de habilidades'
      : 'Skills directory listing'}
  >
    $ ls ~/{t('nav.skills')}
  </p>
  <ul class="skill-categories">
    {
      skills.map((category) => (
        <li class="skill-category">
          <h3 class="category-label">{category.category.toLowerCase()}/</h3>
          <ul class="skill-list">
            {category.groups.flatMap((group) =>
              group.items.map((item) => <li class="skill-item">{item}</li>),
            )}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
