---
import { getSkills } from '../lib/skills';
import { useTranslations, defaultLang } from '../i18n/ui';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const skills = getSkills(lang);
---

<section class="pane pane-skills" aria-labelledby="skills-title">
  <div class="pane-heading">
    <span class="pane-number">04</span>
    <span id="skills-title">{t('nav.skills')}</span>
    <span class="pane-mark">▾</span>
  </div>
  <div class="skill-categories">
    {skills.map((category) => (
      <div class="skill-category">
        <span class="category-label">{category.category}</span>
        {category.groups.map((group) => (
          <div class="skill-block">
            <div class="skill-group-title">
              <span class="tree-marker">&gt;</span> {group.name}
            </div>
            <ul class="skill-list">
              {group.items.map((item) => (
                <li class="skill-item">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>
