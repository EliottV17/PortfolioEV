---
import { useTranslations, defaultLang } from '../i18n/ui';
import { getContact } from '../lib/contact';
import LinkedInIcon from '../assets/icons/linkedin.svg';
import GitHubIcon from '../assets/icons/github.svg';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const contact = getContact(lang);
const englishResume = getContact('en').resume;
const spanishResume = getContact('es').resume;
---

<section class="pane pane-contact" aria-labelledby="contact-title">
  <div class="pane-heading">
    <span class="pane-number">05</span>
    <span id="contact-title">{t('nav.contact')}</span>
    <span class="pane-mark">▾</span>
  </div>

  <div class="contact-grid">
    <div class="contact-primary">
      <p class="contact-copy">
        {contact.copy}
      </p>
      <a class="contact-link" href={`mailto:${contact.email}`}>
        {contact.email} <span>↗</span>
      </a>
    </div>

    <div class="contact-socials">
      <span class="category-label">{t('contact.network')}</span>
      <a
        href={contact.socials.linkedin.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <LinkedInIcon />
        {contact.socials.linkedin.name} ↗
      </a>
      <a
        href={contact.socials.github.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <GitHubIcon />
        {contact.socials.github.name} ↗
      </a>
    </div>

    <div class="contact-terminal">
      <span class="category-label">{t('contact.sysInfo')}</span>
      <p class="sys-info">
        <span>{t('contact.locationLabel')}</span>
        {contact.location}
      </p>
      <p class="sys-info">
        <span>{t('contact.statusLabel')}</span>
        {contact.status}
      </p>
      <div class="cli-box">
        <a
          href={englishResume.path}
          download={englishResume.filename}
          rel="noopener noreferrer"
          class="terminal-line"
          title={t('contact.cvEnTitle')}
        >
          <span class="prompt">$</span> curl -O eliottvelarde/cv-en.pdf [ Download
          ↗ ]
        </a>
        <a
          href={spanishResume.path}
          download={spanishResume.filename}
          hreflang="es"
          rel="noopener noreferrer"
          class="terminal-line"
          title={t('contact.cvEsTitle')}
        >
          <span class="prompt">$</span> curl -O eliottvelarde/cv-es.pdf [ Download
          ↗ ] <span class="cursor"></span>
        </a>
      </div>
    </div>
  </div>
</section>
