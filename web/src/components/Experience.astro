---
import { useTranslations, defaultLang } from '../i18n/ui';
import { getExperience } from '../lib/experience';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const experiences = getExperience(lang);
---

<section class="pane pane-experience" aria-labelledby="experience-title">
  <div class="pane-heading">
    <span class="pane-number">02</span>
    <span id="experience-title">{t('nav.experience')}</span>
    <span class="pane-mark">▾</span>
  </div>
  <div class="timeline">
    {experiences.map((experience, index) => (
      <article class={`timeline-item${index === 0 ? ' current' : ''}`}>
        <span class="timeline-dot"></span>
        <div>
          <p class="date">{experience.date}</p>
          <h2>{experience.role}</h2>
          <p>{experience.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
