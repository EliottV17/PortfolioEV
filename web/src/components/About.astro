---
import { useTranslations, defaultLang } from '../i18n/ui';
import { getAbout } from '../lib/about';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const about = getAbout(lang);
const [firstName, ...surname] = about.name.split(' ');
---

<section class="pane pane-about" aria-labelledby="about-title">
  <div class="pane-heading">
    <span class="pane-number">01</span>
    <span id="about-title">{t('nav.about')}</span><span class="pane-mark"
      >▾</span
    >
  </div>
  <div class="about-content">
    <pre
      class="ascii-avatar"
      role="img"
      aria-label={`ASCII art portrait of ${about.name}`}>
          _____                    _____          
         /\    \                  /\    \         
        /::\    \                /::\____\        
       /::::\    \              /:::/    /        
      /::::::\    \            /:::/    /         
     /:::/\:::\    \          /:::/    /          
    /:::/__\:::\    \        /:::/____/           
   /::::\   \:::\    \       |::|    |            
  /::::::\   \:::\    \      |::|    |     _____  
 /:::/\:::\   \:::\    \     |::|    |    /\    \ 
/:::/__\:::\   \:::\____\    |::|    |   /::\____\
\:::\   \:::\   \::/    /    |::|    |  /:::/    /
 \:::\   \:::\   \/____/     |::|    | /:::/    / 
  \:::\   \:::\    \         |::|____|/:::/    /  
   \:::\   \:::\____\        |:::::::::::/    /   
    \:::\   \::/    /        \::::::::::/____/    
     \:::\   \/____/          ~~~~~~~~~~          
      \:::\    \                                  
       \:::\____\                                 
        \::/    /                                 
         \/____/                                  
                                                  
              </pre>
    <div>
      <p class="eyebrow">{about.eyebrow}</p>
      <h1>{firstName}<br /><em>{surname.join(' ')}</em></h1>
      <p class="role">
        {about.role}<span class="cursor"></span>
      </p>
      <p class="bio">
        {about.bio}
      </p>
      <div class="about-meta">
        <span>{about.location}</span>
        <span>{about.status}</span>
      </div>
    </div>
  </div>
</section>
